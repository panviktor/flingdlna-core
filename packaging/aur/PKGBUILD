# Maintainer: Viktor <viktor@example.com>
pkgname=flingdlna
pkgver=0.1.0
pkgrel=1
pkgdesc="DLNA/Chromecast controller and media server with TUI"
arch=('x86_64' 'aarch64')
url="https://github.com/username/flingdlna"
license=('Apache-2.0')
depends=('gcc-libs')
makedepends=('rust' 'cargo')
optdepends=('ffmpeg: for video duration detection')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/flingdlna" "$pkgdir/usr/bin/flingdlna"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Install systemd user service
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/flingdlna.service" << EOF
[Unit]
Description=FlingDLNA media server and controller daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/flingdlna daemon --foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
}
